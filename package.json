{
  "name": "orion-plg",
  "version": "1.9.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "axios": "^1.5.0",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.13",
    "i18next": "^23.16.8",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.6",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.14.1"
  },
  "scripts": {
    "start:internal": "npm start -w @orion/internal",
    "start:internal:local": "npm run start:local -w @orion/internal",
    "start:branding": "npm start -w @orion/branding-portal",
    "build:internal": "npm run build -w @orion/internal && gzip-all \"apps/internal/build/**/*.{css,js,svg,png,jpg,jpeg,gif,woff,woff2,ttf,eot,otf,mp3,wav,ogg}\"",
    "build:branding": "npm run build -w @orion/branding-portal && gzip-all \"apps/branding-portal/build/**/*.{css,js,svg,png,jpg,jpeg,gif,woff,woff2,ttf,eot,otf,mp3,wav,ogg}\"",
    "analyze:internal": "env-cmd -f .env.analyze npm run build -w @orion/internal",
    "analyze:branding": "env-cmd -f .env.analyze npm run build -w @orion/branding-portal",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,json,md}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "env-cmd": "^10.1.0",
    "eslint-config-react-app": "^7.0.1",
    "gzip-all": "^1.0.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "sass": "^1.89.2",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.0.3"
  }
}
